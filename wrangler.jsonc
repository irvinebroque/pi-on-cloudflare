/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pi-on-cloudflare-code",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-12",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"build": {
		"command": "npm run build:assets"
	},
	"vars": {
		"PI_MODEL": "openai/gpt-4.1-mini",
		"AI_GATEWAY_ID": "default"
	},
	"ai": {
		"binding": "AI"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "PiAgent",
				"class_name": "PiAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PiAgent"]
		}
	],
	"assets": {
		"directory": "./public",
		"run_worker_first": ["/api/*"]
	}
}
